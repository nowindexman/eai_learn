  "cards": [
    {
      "dot": "cyan",
      "title": "先分清三层",
      "items": [
        "rosbag/rosbag2 是 ROS 生态的录制工具与管理方式",
        "MCAP 是可承载多种编码的开放式容器",
        "容器能读、消息能解码、业务语义正确是三件事"
      ]
    },
    {
      "dot": "amber",
      "title": "数据集化关键",
      "items": [
        "时间基准要明确：log time 还是 header.stamp",
        "单位、关节顺序、frame_id 和缺失策略不能靠猜",
        "Parquet/图像索引是派生结果，不替代原始日志"
      ]
    },
    {
      "dot": "emerald",
      "title": "工程闭环",
      "items": [
        "raw 原始数据只读，阶段输出分层保存",
        "同一输入、配置和代码版本应可幂等重跑",
        "manifest、SHA-256、质量报告共同证明可复现"
      ]
    }
  ]
